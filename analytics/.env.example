# Analytics service observability.
SENTRY_DSN=replace-with-analytics-service-sentry-dsn
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=replace-with-release-or-git-sha
SENTRY_TRACES_SAMPLE_RATE=0

METRICS_ENABLED=true
METRICS_AUTH_TOKEN=replace-with-same-token-as-root-env

# Optional explicit service label. Defaults to analytics-service.
SERVICE_NAME=analytics-service
SESSIONS_MONGO_URI=

# Meta (Facebook) Ads API — used to pull real ad spend for the P&L "Meta"
# line item, per brand. Each brand connects its own ad account + access
# token from the P&L page; it lands encrypted in Mongo (meta_ads_credentials,
# one document per brand, PASSWORD_AES_KEY required) where the pipeline's
# P&L worker picks it up to pull daily spend.
#
# META_APP_ID / META_APP_SECRET are your OWN Meta developer app (one app,
# shared across all brands) — required only to auto-exchange a brand's
# pasted token for a long-lived one. Create the app at
# developers.facebook.com, add the Marketing API product, and use its
# App ID / App Secret here. Safe to leave blank; tokens are still accepted
# and used as pasted, just without the auto-refresh convenience.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# Optional fallback ad account + token used only when a brand hasn't
# connected its own via the P&L page yet (handy for local/single-brand dev).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads (P&L page): merchants paste their customer id + token on the
# page; it lands encrypted in Mongo (google_ads_credentials), so PASSWORD_AES_KEY
# must be set. The pipeline's Google Ads sync reads that document; this
# service never calls Google itself.

# Optional health-monitor application event reporting.
HEALTH_MONITOR_EVENTS_URL=http://health-monitor-service:4015/events
HEALTH_MONITOR_EVENT_TIMEOUT_MS=5000
HEALTH_MONITOR_SUCCESS_CACHE_TTL_MS=1800000
HEALTH_MONITOR_EVENT_PAYLOAD_MAX_LENGTH=2000
HEALTH_MONITOR_EVENT_HEADER_VALUE_MAX_LENGTH=300
