# kafka-service (infrastructure only). Every value has a default in docker-compose.yml,
# so none of these are required. Copy entries into the root .env only to override.

# Official Apache Kafka image tag (KRaft mode, no ZooKeeper).
KAFKA_IMAGE_TAG=3.9.1
# JVM heap. Sized for a 4 GB EC2 host that also runs the other services.
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
# Container memory cap (heap + page cache headroom).
KAFKA_MEM_LIMIT=1g
# Single broker, so replication factor must stay 1.
KAFKA_REPLICATION_FACTOR=1
# Address other containers on pipeline-net use to reach the broker.
KAFKA_BOOTSTRAP_SERVERS=kafka-service:9092
