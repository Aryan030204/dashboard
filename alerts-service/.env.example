# Alerts service observability.
SENTRY_DSN=replace-with-alerts-service-sentry-dsn
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=replace-with-release-or-git-sha
SENTRY_TRACES_SAMPLE_RATE=0

METRICS_ENABLED=true
METRICS_AUTH_TOKEN=replace-with-same-token-as-root-env

# Optional explicit service label. Defaults to alerts-service.
SERVICE_NAME=alerts-service

# Intent event ingestion: "mongo" (default, sessions-pipeline logic into intent_sessions) or "sqs".
# No AWS access keys: the SDK uses the EC2 instance role via the default credential chain.
INTENT_EVENT_INGESTION=mongo

# intent_sessions database (events, click_events, actor_cursors, session_history).
# Required when INTENT_EVENT_INGESTION=mongo. Separate from MONGO_URI/alerts.
INTENT_MONGO_URI=mongodb+srv://user:password@cluster.example.net/intent_sessions
# Session inactivity window in seconds (default 1800 = 30 min).
SESSION_TIMEOUT=1800
# Brands accepted by intent /track (comma-separated brand ids the pixel sends).
# A brand not listed here is unknown or inactive and gets 400. Read at startup.
INTENT_BRANDS_ALLOWLIST=bbb_shop,pts_shop,shyle_shop
# IANA timezone per allow-listed brand. Required for every brand in the allow-list.
# Example values only: set each store's real timezone.
INTENT_BRAND_TIMEZONES=bbb_shop=Asia/Kolkata,pts_shop=Asia/Kolkata,shyle_shop=Asia/Kolkata
AWS_REGION=ap-south-1
SQS_INTENT_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/923233838659/intent-events
# SQS producer bounds (used when INTENT_EVENT_INGESTION=sqs). Defaults shown.
# Max SendMessage calls in flight at once. Keep well above the steady-state rate x latency.
INTENT_SQS_MAX_CONCURRENCY=32
# Max sends waiting for a slot. Beyond this, /track returns 503 immediately.
INTENT_SQS_MAX_PENDING=200
# Max time a waiting send can block for a slot before it returns 503 (ms).
INTENT_SQS_MAX_WAIT_MS=3000
# Total SendMessage attempts for transient errors (1 = no retry).
INTENT_SQS_MAX_ATTEMPTS=2
# HTTPS agent sockets. Must be >= INTENT_SQS_MAX_CONCURRENCY, or requests queue for a socket.
INTENT_SQS_MAX_SOCKETS=64
INTENT_SQS_MAX_FREE_SOCKETS=32
# Hard deadline for one SendMessage attempt (ms). Must stay well below the gateway proxy timeout (25 s).
INTENT_SQS_SEND_TIMEOUT_MS=8000

# Optional health-monitor application event reporting.
HEALTH_MONITOR_EVENTS_URL=http://health-monitor-service:4015/events
HEALTH_MONITOR_EVENT_TIMEOUT_MS=5000
HEALTH_MONITOR_SUCCESS_CACHE_TTL_MS=1800000
HEALTH_MONITOR_EVENT_PAYLOAD_MAX_LENGTH=2000
HEALTH_MONITOR_EVENT_HEADER_VALUE_MAX_LENGTH=300
