PORT=4040
NODE_ENV=production
CORS_ORIGINS=

# Gateway trust. The secret is inherited from the root .env that compose loads first, so normally
# leave it OUT of this file. Only set it here if it must differ, and then it must be EXACTLY the
# value the api-gateway signs with. A placeholder or wrong value here overrides the real one and
# every request fails with 401. The service refuses to start without a real secret.
# GATEWAY_SHARED_SECRET=
ALLOW_INSECURE_AUTH=false

# Central MySQL (MySQL 8). Run migrations/001-create-weekly-reports.sql once.
WR_DB_HOST=
WR_DB_PORT=3306
WR_DB_USER=
WR_DB_PASSWORD=
WR_DB_NAME=

# Dedicated PRIVATE bucket (Block Public Access on). Credentials come from the instance role.
WEEKLY_REPORTS_BUCKET=
AWS_REGION=ap-south-1
# S3_ENDPOINT=http://minio:9000   # local testing only

# Meeting Pointers (Fireflies import). Run migrations/006-create-meeting-pointers.sql once.
# MongoDB holds only the encrypted Fireflies connection (collection fireflies_connections). Optional: without it
# /meeting-pointers answers 503 and Weekly Reports is unaffected. Do not commit real values.
WR_MONGO_URI=
WR_MONGO_DB=datum_meetings
# AES-256 key that encrypts the Fireflies API key before it is stored (AES-256-CBC). Exactly 32 bytes: 64 hex characters
# or base64 of 32 bytes. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it in the server environment only; it is never stored in MongoDB. Changing it makes the stored key unreadable
# (an admin then saves the Fireflies API key again).
FIREFLIES_API_KEY_ENCRYPTION_KEY=
# FIREFLIES_TIMEOUT_MS=15000
# FIREFLIES_IMPORT_MAX_ATTEMPTS=5
# FIREFLIES_RETRY_BASE_MS=30000
# FIREFLIES_RETRY_MAX_MS=900000
# MEETING_IMPORT_STALE_MS=300000

# Limits
MAX_UPLOAD_BYTES=52428800
MAX_SLIDES=100

# Chunked uploads (browser -> Vercel function -> service). Keep the chunk well under Vercel's ~4.5 MB limit.
# UPLOAD_CHUNK_BYTES=3145728
# UPLOAD_SESSION_TTL_MS=1800000
# MAX_UPLOAD_SESSIONS_PER_USER=3

# Worker
CONVERT_TIMEOUT_MS=300000
WORKER_POLL_MS=5000
CANCEL_POLL_MS=2000   # how quickly a running job notices it was cancelled

# 403 (default) or 404 when a user asks for another brand's report id
CROSS_BRAND_STATUS=403
