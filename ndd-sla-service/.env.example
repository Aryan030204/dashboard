# NDD / SLA Reports service + worker. Compose loads the root .env first, then this file.
# Values marked [CONFIRM] are open business/infra decisions: there is deliberately NO default in code for them.

PORT=4050
NODE_ENV=production

# Gateway trust. Inherited from the root .env; normally leave it OUT of this file (see weekly-reports-service/.env.example).
# GATEWAY_SHARED_SECRET=
ALLOW_INSECURE_AUTH=

# Encryption key for stored Gmail/EasyCom credentials. Same shared key tenant-router and analytics use; it reaches the
# container through the root .env. The service refuses to start without it.
# PASSWORD_AES_KEY=

# MySQL: the SAME server/database as weekly-reports (tables are namespaced ndd_sla_*). Apply
# migrations/001-create-ndd-sla.sql once, by hand, before deploying. [CONFIRM the instance]
NDD_DB_HOST=
NDD_DB_PORT=3306
NDD_DB_USER=
NDD_DB_PASSWORD=
NDD_DB_NAME=

# Brand this deployment ingests for (AJMAL only for now; every row still carries brand_key).
NDD_SLA_BRAND_KEY=AJMAL

# --- Report window rules (Business decision K1: REQUIRED, no defaults) -----------------------------------------------
# CONFIRMED: report date = the date the window ENDS on.
NDD_SLA_REPORT_DATE_ANCHOR=end   # default; blank also means end
# CONFIRMED: NDD window 12:00 -> next day 12:00 IST, everything else 15:00 -> next day 15:00 IST (start inclusive, end exclusive).
NDD_SLA_NDD_START_TIME=12:00
NDD_SLA_OTHER_START_TIME=15:00
# Window length in hours (PRD: 12 PM -> 12 PM and 3 PM -> 3 PM = 24).
NDD_SLA_WINDOW_LENGTH_HOURS=24
# CONFIRMED: IST.
NDD_SLA_TIMEZONE=Asia/Kolkata

# --- Source column names (defaults are the PRD's labels; verify against a real GoKwik file) [CONFIRM] -----------------
# NDD_SLA_COL_REFERENCE=Reference Code
# NDD_SLA_COL_CLIENT_LOCATION=Client Location
# NDD_SLA_COL_ORDER_STATUS=Order Status
# NDD_SLA_COL_COURIER=Courier
# Other accepted spellings (comma-separated, replaces the built-in list), e.g. NDD_SLA_COL_COURIER_ALIASES=Courier,Courier Name
# Same pattern for REFERENCE, CLIENT_LOCATION, ORDER_STATUS, ORDER_DATE and NDD_SLA_EASYCOM_FILE_COL_{REFERENCE,PICKED_AT}_ALIASES.
# NDD_SLA_COL_ORDER_DATE=Order Date
# Sales-channel filter: when the order file has an "MP Name" column, only these channels are counted (comma-separated;
# empty = count every channel). Flipkart/Firstcry orders never go through GoKwik, so without this they all show as breached.
# NDD_SLA_MARKETPLACES=Shopify
# NDD_SLA_COL_MARKETPLACE=MP Name

# --- Memory / throughput knobs: provisional, MUST be validated with real file sizes (no benchmark exists yet) --------
# NDD_SLA_DB_BATCH_ROWS=1000
# NDD_SLA_PAUSE_MAX_MINUTES=30      a paused report is cancelled after this long
# NDD_SLA_MAX_KEPT_ROWS=250000        safety ceiling on qualifying orders held in memory (not benchmarked); exceeding it fails the run
# NDD_SLA_MAX_ATTACHMENT_BYTES=26214400
# NDD_SLA_WORKER_MEM_LIMIT=768m
# NDD_SLA_API_MEM_LIMIT=256m
# NDD_SLA_POLL_MS=60000

# --- Ingestion modes: automated (worker: Gmail + EasyCom API) and/or manual upload (an author uploads both files) -------
# NDD_SLA_AUTO_ENABLED=true          false = the worker idles; no Gmail/EasyCom configuration is then needed
# NDD_SLA_UPLOAD_ENABLED=true        false = the upload endpoint answers 404
# NDD_SLA_MAX_UPLOAD_BYTES=31457280  per file as sent (the browser gzips; ~4 MB total through the Vercel proxy)
# NDD_SLA_MAX_EXPANDED_BYTES=157286400  per file after un-gzipping (zip-bomb guard)
# NDD_SLA_UPLOAD_MAX_KEPT_ROWS=100000   safety ceiling for an upload (the API container is smaller than the worker)
# Column names inside the uploaded EasyCom export (defaults are the PRD labels; verify against a real export):
# NDD_SLA_EASYCOM_FILE_COL_REFERENCE=Reference Code
# NDD_SLA_EASYCOM_FILE_COL_PICKED_AT=Shipment(Pickup At)

# --- Worker behaviour (provisional knobs) -----------------------------------------------------------------------------
# NDD_SLA_MAX_ATTEMPTS=5            failed attempts before a run stays failed (waiting for GoKwik does not count)
# NDD_SLA_BACKOFF_BASE_MS=60000     retry delay = base * 2^attempts, capped by NDD_SLA_BACKOFF_MAX_MS=1800000
# NDD_SLA_LOCK_STALE_MS=900000      a run lock with no heartbeat for this long is released (dead worker)
# NDD_SLA_GOKWIK_DEADLINE_HOURS=24  after the windows close, waiting longer than this = GOKWIK_TIMEOUT
# NDD_SLA_SCHEDULE_LOOKBACK_DAYS=2  report dates (today and earlier) the scheduler keeps ensuring
# NDD_SLA_TMP_DIR=                  where the attachment is written while it is streamed (default: OS temp dir)
# NDD_SLA_LOG_LEVEL=info

# --- Gmail / GoKwik email matching: REQUIRED, production values NOT in this repo --------------------------------------
# The worker refuses to start while any of these is empty.
NDD_SLA_GMAIL_SENDER=                 # exact address, or comma-separated list
NDD_SLA_GMAIL_SUBJECT_PATTERN=        # regular expression, case-insensitive
NDD_SLA_GMAIL_FILENAME_PATTERN=       # regular expression for the CSV attachment name, case-insensitive
# NDD_SLA_GMAIL_PICK=first            first|latest when several emails match (the rest are counted in duplicate_messages)
# NDD_SLA_GMAIL_LOOKAHEAD_HOURS=24    emails are searched from the earliest window end for this many hours
# The stored GMAIL credential is an OAuth refresh token (table ndd_sla_credentials); the OAuth client is deployment config:
NDD_GMAIL_CLIENT_ID=
NDD_GMAIL_CLIENT_SECRET=

# --- EasyCom: REQUIRED, nothing is assumed in code ------------------------------------------------------------------
# The EasyCom token is stored encrypted in ndd_sla_credentials (provider EASYCOM). All of the below describe THEIR API.
NDD_EASYCOM_BASE_URL=
NDD_EASYCOM_ENDPOINT=
NDD_EASYCOM_AUTH_MODE=                # bearer | header | query | none
# NDD_EASYCOM_AUTH_HEADER=            when AUTH_MODE=header (header name carrying the token)
# NDD_EASYCOM_AUTH_QUERY_PARAM=       when AUTH_MODE=query
# NDD_EASYCOM_STATIC_QUERY={}         JSON of fixed query parameters
# NDD_EASYCOM_FROM_PARAM=             optional: parameter name for the order-date range start (sent as "YYYY-MM-DD HH:mm:ss")
# NDD_EASYCOM_TO_PARAM=
NDD_EASYCOM_PAGINATION_MODE=          # page | offset | cursor
# NDD_EASYCOM_PAGE_SIZE=100
# NDD_EASYCOM_PAGE_SIZE_PARAM=        required for page/offset (optional for cursor)
# NDD_EASYCOM_PAGE_PARAM=             page mode
# NDD_EASYCOM_START_PAGE=1
# NDD_EASYCOM_OFFSET_PARAM=           offset mode
# NDD_EASYCOM_CURSOR_PARAM=           cursor mode
# NDD_EASYCOM_NEXT_CURSOR_PATH=       cursor mode: dot path of the next cursor in the response
# NDD_EASYCOM_HAS_MORE_PATH=          optional: dot path of a boolean "more pages" flag
NDD_EASYCOM_ITEMS_PATH=               # dot path of the array of shipments in the response, e.g. data.items
NDD_EASYCOM_FIELD_REFERENCE=          # dot path of the Reference Code inside each shipment
NDD_EASYCOM_FIELD_PICKED_AT=          # dot path of "Shipment Picked At" inside each shipment
# NDD_EASYCOM_MAX_PAGES=1000
# NDD_EASYCOM_TIMEOUT_MS=30000
